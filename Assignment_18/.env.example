# Assignment 18: Fruit Quality Detector Configuration
# Copy this file to .env and fill in your actual values

# ==================== SIMULATOR MODE ====================
# Set to 'true' for testing without hardware
# Set to 'false' to use real sensors
SIMULATOR_MODE=true

# ==================== PROXIMITY SENSOR ====================
# Distance threshold in cm to trigger camera capture
# Real sensor range: 2-400 cm
PROXIMITY_TRIGGER_DISTANCE=20

# ==================== CAMERA CONFIGURATION ====================
# USB camera device ID (usually 0 for default camera)
# If multiple cameras: try 0, 1, 2, etc.
CAMERA_DEVICE_ID=0

# ==================== DETECTION LOOP ====================
# Interval in seconds between proximity measurements
# Lower values: more detections but higher CPU
# Recommended: 0.1 - 1.0 seconds
DETECTION_INTERVAL=0.5

# ==================== AZURE BLOB STORAGE ====================
# Connection string for Azure Blob Storage
# Format: DefaultEndpointProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
# Leave empty to use local storage simulator
STORAGE_CONNECTION_STRING=

# Azure Blob Storage container name
# Will be created automatically if it doesn't exist
STORAGE_CONTAINER=fruit-images

# ==================== AZURE IOT HUB ====================
# Connection string for Azure IoT Hub
# Format: HostName=<hub-name>.azure-devices.net;SharedAccessKeyName=owner;SharedAccessKey=<key>
# Leave empty to use IoT Hub simulator
IOT_HUB_CONNECTION_STRING=

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== HARDWARE PINS (RPi/Jetson) ====================
# GPIO pin numbers (BCM numbering) - only used when SIMULATOR_MODE=false
GPIO_PROXIMITY_TRIGGER=23
GPIO_PROXIMITY_ECHO=24
GPIO_LED_RED=27
GPIO_LED_GREEN=17
GPIO_LED_YELLOW=22
GPIO_BUZZER=26

# ==================== OPTIONAL SETTINGS ====================
# Output directory for captured images
OUTPUT_DIR=./captures

# Local storage directory for simulator mode
LOCAL_STORAGE_DIR=./cloud_storage

# Enable debug mode (very verbose logging)
DEBUG_MODE=false
