# Azure Speech Service Credentials
SPEECH_KEY=your_speech_api_key_here
SPEECH_REGION=eastus

# Assignment 22 REST Endpoint (default: local)
# Local: http://localhost:7071/api/text-to-timer
# Cloud: https://your-app-name.azurewebsites.net/api/text-to-timer?code=YOUR_KEY
TEXT_TO_TIMER_ENDPOINT=http://localhost:7071/api/text-to-timer

# Text-to-Speech Voice
# See: https://docs.microsoft.com/en-us/azure/cognitive-services/speech-service/language-support#text-to-speech
# English options: en-US-AriaNeural, en-US-GuyNeural, en-GB-LibbyNeural, etc.
TTS_VOICE=en-US-AriaNeural
