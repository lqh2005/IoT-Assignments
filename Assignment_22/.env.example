# LUIS Configuration
# Get these from LUIS Portal (luis.ai) > Manage > Azure Resources

# Your LUIS Authoring/Prediction API Key
LUIS_KEY=your_luis_api_key_here

# Your LUIS Endpoint URL (e.g., https://eastus.api.cognitive.microsoft.com/)
LUIS_ENDPOINT_URL=https://eastus.api.cognitive.microsoft.com/

# Your LUIS App ID (found in Settings tab)
LUIS_APP_ID=your_app_id_here_12345678
