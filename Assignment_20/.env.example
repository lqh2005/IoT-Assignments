# Environment Configuration Template
# Copy to .env and fill in your values

# ========================================
# DEPLOYMENT SETTINGS
# ========================================

# Device type: raspberry_pi, jetson_nano, laptop
DEVICE_TYPE=raspberry_pi

# Model path (after export)
MODEL_PATH=./exported_models/fruit_detector_int8.tflite

# Input image size (matches model training)
IMAGE_WIDTH=224
IMAGE_HEIGHT=224

# ========================================
# INFERENCE SETTINGS
# ========================================

# Confidence threshold for predictions
CONFIDENCE_THRESHOLD=0.5

# Batch size for inference
BATCH_SIZE=1

# Number of threads for inference
NUM_THREADS=4

# ========================================
# EDGE DEVICE SETTINGS (Raspberry Pi)
# ========================================

# GPIO pin for LED control
LED_PIN=17

# GPIO pin for button input
BUTTON_PIN=27

# ========================================
# PERFORMANCE SETTINGS
# ========================================

# Enable inference time logging
LOG_INFERENCE_TIME=true

# Benchmark mode (log every N inferences)
BENCHMARK_INTERVAL=100

# ========================================
# DEBUG SETTINGS
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable verbose output
VERBOSE=false

# Save inference results to file
SAVE_RESULTS=true

# Results output file
RESULTS_FILE=./inference_results.json
